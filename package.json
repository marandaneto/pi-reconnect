{
  "name": "pi-reconnect",
  "version": "0.1.0",
  "description": "Automatically retry Pi after your internet connection returns, without injecting a message.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marandaneto/pi-reconnect.git"
  },
  "homepage": "https://github.com/marandaneto/pi-reconnect#readme",
  "bugs": {
    "url": "https://github.com/marandaneto/pi-reconnect/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "reconnect",
    "offline"
  ],
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
